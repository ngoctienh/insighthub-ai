# ============================================================
# InsightHub AI - Environment Variables Template
# Copy to .env for local development. NEVER commit .env!
# ============================================================

# --- Django Core ---
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key-min-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- PostgreSQL Database ---
# Example local/Docker: postgresql://insighthub:insighthub_pass@localhost:5432/insighthub
# Example cloud (Render/Neon/Supabase): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://insighthub:insighthub_pass@localhost:5432/insighthub
# Set True only for quick local testing when PostgreSQL is unavailable
USE_SQLITE_FALLBACK=False

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# When False (default in local without Redis), AI tasks run synchronously via API fallback
CELERY_ENABLED=False

# --- AI Microservice Connection ---
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=change-this-internal-service-secret
AI_SERVICE_TIMEOUT=60

# --- LLM & Embedding Providers (Optional - Local ML fallback works automatically) ---
# Options: auto | openai | anthropic | local
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Demo Seed Configuration (Optional) ---
# Use a custom password for seeded accounts in staging/production
DEMO_USER_PASSWORD=InsightDemo!2026
